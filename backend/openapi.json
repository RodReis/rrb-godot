{
  "openapi": "3.0.0",
  "paths": {
    "/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensDto"
                }
              }
            }
          },
          "400": {
            "description": "WEAK_PASSWORD | PASSWORD_TOO_LONG | INVALID_EMAIL | VALIDATION_FAILED"
          },
          "409": {
            "description": "EMAIL_TAKEN"
          },
          "429": {
            "description": "RATE_LIMITED"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensDto"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS"
          },
          "429": {
            "description": "RATE_LIMITED"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensDto"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_REFRESH_TOKEN"
          },
          "429": {
            "description": "RATE_LIMITED"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/users/me": {
      "get": {
        "operationId": "UsersController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileDto"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "users"
        ]
      }
    },
    "/queue": {
      "post": {
        "operationId": "QueueController_join",
        "parameters": [],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueTicketDto"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED"
          },
          "409": {
            "description": "ALREADY_QUEUED (ticket ativo ou partida em andamento)"
          },
          "429": {
            "description": "RATE_LIMITED"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "queue"
        ]
      }
    },
    "/queue/{ticket}": {
      "get": {
        "operationId": "QueueController_status",
        "parameters": [
          {
            "name": "ticket",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketStatusDto"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED"
          },
          "404": {
            "description": "TICKET_NOT_FOUND"
          },
          "429": {
            "description": "RATE_LIMITED"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "queue"
        ]
      },
      "delete": {
        "operationId": "QueueController_cancel",
        "parameters": [
          {
            "name": "ticket",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "description": "UNAUTHORIZED"
          },
          "404": {
            "description": "TICKET_NOT_FOUND"
          },
          "409": {
            "description": "ALREADY_MATCHED"
          },
          "429": {
            "description": "RATE_LIMITED"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "queue"
        ]
      }
    },
    "/matches/{id}/abandon": {
      "post": {
        "operationId": "MatchesController_abandon",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "description": "UNAUTHORIZED"
          },
          "404": {
            "description": "MATCH_NOT_FOUND"
          },
          "409": {
            "description": "MATCH_NOT_ASSIGNED"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "matches"
        ]
      }
    },
    "/internal/matches/{id}/validate": {
      "post": {
        "operationId": "InternalMatchesController_validate",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidatedMatchDto"
                }
              }
            }
          },
          "401": {
            "description": "INTERNAL_UNAUTHORIZED | TOKEN_INVALID | TOKEN_EXPIRED"
          },
          "404": {
            "description": "MATCH_NOT_FOUND"
          },
          "409": {
            "description": "MATCH_NOT_ACTIVE"
          }
        },
        "security": [
          {
            "internal-secret": []
          }
        ],
        "tags": [
          "internal"
        ]
      }
    },
    "/internal/matches/{id}/heartbeat": {
      "post": {
        "operationId": "InternalMatchesController_heartbeat",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "description": "INTERNAL_UNAUTHORIZED"
          },
          "404": {
            "description": "MATCH_NOT_FOUND"
          },
          "409": {
            "description": "MATCH_NOT_RUNNING"
          }
        },
        "security": [
          {
            "internal-secret": []
          }
        ],
        "tags": [
          "internal"
        ]
      }
    },
    "/internal/matches/{id}/result": {
      "post": {
        "operationId": "InternalMatchesController_result",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchResultDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          },
          "400": {
            "description": "INVALID_RESULT | VALIDATION_FAILED"
          },
          "401": {
            "description": "INTERNAL_UNAUTHORIZED"
          },
          "404": {
            "description": "MATCH_NOT_FOUND"
          },
          "409": {
            "description": "MATCH_NOT_RUNNING"
          }
        },
        "security": [
          {
            "internal-secret": []
          }
        ],
        "tags": [
          "internal"
        ]
      }
    }
  },
  "info": {
    "title": "rrb-godot backend",
    "description": "Erros: { statusCode, code, message }. `code` é o contrato com o Launcher.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "internal-secret": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-secret"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "^(?=.*\\p{L})(?=.*\\d)",
            "description": "Mínimo 8 caracteres, com pelo menos uma letra e um número"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthTokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "email",
          "createdAt"
        ]
      },
      "QueueTicketDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "status": {
            "type": "string",
            "enum": [
              "searching"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "status",
          "createdAt"
        ]
      },
      "TicketStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "searching",
              "matched",
              "cancelled"
            ]
          },
          "elapsedS": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "assignment": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "token": {
                "type": "string"
              }
            },
            "required": [
              "host",
              "port",
              "token"
            ]
          }
        },
        "required": [
          "status",
          "elapsedS"
        ]
      },
      "ValidateDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "token"
        ]
      },
      "ValidatedMatchDto": {
        "type": "object",
        "properties": {
          "matchId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "playerIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "seed": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "matchId",
          "userId",
          "playerIds",
          "seed"
        ]
      },
      "MatchResultDto": {
        "type": "object",
        "properties": {
          "winnerUserId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "nullable": true
          },
          "endReason": {
            "type": "string",
            "pattern": "^[a-z_]{1,32}$"
          },
          "durationS": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "players": {
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "userId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "heroId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "kills": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "deaths": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "finalLevel": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "damageDealt": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "damageTaken": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "monstersKilled": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "chestsOpened": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "bossKill": {
                  "type": "boolean"
                },
                "setActive": {
                  "type": "string",
                  "maxLength": 64,
                  "nullable": true
                },
                "levelAtPhase1End": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647,
                  "nullable": true
                },
                "avgPingMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647,
                  "nullable": true
                }
              },
              "required": [
                "userId",
                "heroId",
                "kills",
                "deaths",
                "finalLevel",
                "damageDealt",
                "damageTaken",
                "monstersKilled",
                "chestsOpened",
                "bossKill"
              ]
            }
          }
        },
        "required": [
          "winnerUserId",
          "endReason",
          "durationS",
          "players"
        ]
      }
    }
  }
}
