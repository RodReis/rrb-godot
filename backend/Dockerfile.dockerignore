# Contexto do build do backend (BuildKit usa este arquivo no lugar do .dockerignore da raiz): so o
# backend e o web-admin, que a imagem serve em /admin-ui.
*
!backend
!admin
backend/node_modules
backend/dist
backend/coverage
backend/.env
backend/.env.*
!backend/.env.example
admin/.env
admin/.env.*
admin/node_modules
admin/dist
