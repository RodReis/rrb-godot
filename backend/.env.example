# Backend (src/config.ts valida tudo no boot). Copie para .env só em dev; nunca commite .env.

# Postgres 16. Local: docker compose -f infra/docker-compose.yml --profile backend up -d postgres
DATABASE_URL=postgres://rrb:rrb@localhost:5432/rrb
# Segredo HS256 dos JWT (access 15 min, refresh 7 d). Mínimo 32 caracteres; um por ambiente.
JWT_SECRET=
# Segredo compartilhado só entre backend e game server (endpoints /internal/*, header x-internal-secret).
# Mínimo 32 caracteres; diferente do JWT_SECRET; nunca vai para o cliente.
INTERNAL_SECRET=
PORT=3000
# Saltos de proxy confiáveis para o IP real do cliente (Coolify/Traefik: 1). 0 = sem proxy.
TRUST_PROXY_HOPS=0
# Rate limit de /auth/*: AUTH_RATE_LIMIT requisições por AUTH_RATE_TTL_MS, por IP.
AUTH_RATE_LIMIT=10
AUTH_RATE_TTL_MS=60000

# Fila e orquestrador (F22). Rate limit de POST/DELETE /queue (o polling do GET não conta).
QUEUE_RATE_LIMIT=10
QUEUE_RATE_TTL_MS=60000
# Validade do token de partida; ticket sem polling do Launcher por TICKET_STALE_MS expira.
MATCH_TOKEN_TTL_S=120
TICKET_STALE_MS=10000
# Game server manda heartbeat a cada HEARTBEAT_INTERVAL_MS; HEARTBEAT_MISS_LIMIT faltas = partida aborted.
HEARTBEAT_INTERVAL_MS=10000
HEARTBEAT_MISS_LIMIT=3
# Varredura periódica (tokens vencidos, heartbeats, pareamento pendente). 0 desliga.
SWEEP_INTERVAL_MS=2000
# Pool de game servers: POOL_SIZE pré-aquecidos, até POOL_MAX sob demanda, portas UDP GAME_PORT_MIN..MAX.
POOL_SIZE=2
POOL_MAX=10
GAME_PORT_MIN=7000
GAME_PORT_MAX=7020
# Imagem (infra/gameserver), host/IP que o Launcher recebe e URL do backend vista de dentro do container.
GAMESERVER_IMAGE=rrb-gameserver:latest
GAMESERVER_PUBLIC_HOST=127.0.0.1
GAMESERVER_BACKEND_URL=http://host.docker.internal:3000
# Produção (Coolify): rede do compose em que os game servers entram; com ela, GAMESERVER_BACKEND_URL=http://backend:3000. Vazio = rede padrão (dev).
GAMESERVER_NETWORK=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Versão mínima do Launcher para entrar na fila (vX.Y.Z; F83, ADR-0023). Vazio = aceita todas.
MIN_CLIENT_VERSION=

# Só o e2e (pnpm test:e2e). Padrão: postgres://rrb:rrb@localhost:5432/rrb_test
TEST_DATABASE_URL=postgres://rrb:rrb@localhost:5432/rrb_test
