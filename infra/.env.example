# Variaveis do Coolify para infra/docker-compose.prod.yml. Cadastre no painel; nunca commite valores.
# Gere os segredos com:  openssl rand -hex 32   (JWT_SECRET e INTERNAL_SECRET devem ser diferentes)

# Senha do Postgres. Somente hex/alfanumerico (entra numa URL de conexao).
POSTGRES_PASSWORD=
# Segredo HS256 dos JWT dos jogadores (minimo 32 caracteres).
JWT_SECRET=
# Segredo entre backend e game server para /internal/* (minimo 32 caracteres).
INTERNAL_SECRET=
# IP publico ou dominio do VPS que o Launcher recebe para conectar por UDP (faixa 7000–7020).
GAMESERVER_PUBLIC_HOST=
# Nome da rede Docker do compose. No Coolify e o UUID do recurso (aparece na URL do recurso e em
# `docker network ls`), nao `rrb-net`. Sem isso o orquestrador nao sobe game server.
GAMESERVER_NETWORK=rrb-net
# GID do grupo docker do host (getent group docker | cut -d: -f3). Padrao 999.
DOCKER_GID=999
# Opcionais: game servers pre-aquecidos / maximo simultaneo e nivel de log.
POOL_SIZE=2
POOL_MAX=10
LOG_LEVEL=info
# Versão mínima do Launcher para entrar na fila (vX.Y.Z; F83, ADR-0023). Vazio = aceita todas.
MIN_CLIENT_VERSION=
