[sub_resource type="Resource" id="basic"]
script = ExtResource("2_skill")
id = &"engineer_basic"
icon = ExtResource("icon_basic")
display_name = "Bacamarte"
description = "Tiro de bacamarte em cone de 40° e 4,5 u, instantâneo: acerta todos os inimigos no cone. A Muralha o trata como golpe corpo a corpo. Dano: 100% do ATQ em cada alvo."
max_rank = 1
required_hero_level = PackedInt32Array(1)
cooldown = PackedFloat64Array(1.2)
attack_ratio = 1.0
attack_range = 4.5
arc_degrees = 40.0

[sub_resource type="Resource" id="q"]
script = ExtResource("2_skill")
id = &"engineer_q"
icon = ExtResource("icon_q")
display_name = "Garra Mecânica"
description = "Lança uma garra (7 u) que para no primeiro inimigo; o herói atingido é puxado em 0,3 s até 2 u do Engenheiro. Monstro e chefe só tomam dano. A Muralha bloqueia. Dano: base do rank + 70% do ATQ."
max_rank = 5
required_hero_level = PackedInt32Array(1)
cooldown = PackedFloat64Array(11.0, 10.5, 10.0, 9.5, 9.0)
base_amount = PackedFloat64Array(50.0, 80.0, 110.0, 140.0, 170.0)
attack_ratio = 0.7
attack_range = 7.0
radius = 0.4
speed = 20.0
distance = 2.0
duration = PackedFloat64Array(0.3)

[sub_resource type="Resource" id="e"]
script = ExtResource("2_skill")
id = &"engineer_e"
icon = ExtResource("icon_e")
display_name = "Torreta"
description = "Instala uma torreta no ponto mirado (até 3 u) por 6 s: a cada 0,75 s atira no inimigo mais próximo a até 7 u que o Engenheiro vê. Indestrutível, uma por vez. Dano por disparo: base do rank + 15% do ATQ."
max_rank = 5
required_hero_level = PackedInt32Array(2)
cooldown = PackedFloat64Array(14.0)
base_amount = PackedFloat64Array(14.0, 20.0, 26.0, 32.0, 38.0)
attack_ratio = 0.15
attack_range = 7.0
cast_range = 3.0
duration = PackedFloat64Array(6.0)
pulse_count = 8
pulse_interval = 0.75

[sub_resource type="Resource" id="r"]
script = ExtResource("2_skill")
id = &"engineer_r"
icon = ExtResource("icon_r")
display_name = "Caixa de Dinamite"
description = "Posiciona uma caixa no ponto mirado (até 6 u); explode 1,5 s depois em raio de 4,5 u, ferindo e empurrando 3 u para fora. Dano: base do rank + 130% da INT + 60% do ATQ."
max_rank = 2
required_hero_level = PackedInt32Array(6, 10)
cooldown = PackedFloat64Array(55.0, 46.0)
base_amount = PackedFloat64Array(240.0, 380.0)
attack_ratio = 0.6
intelligence_ratio = 1.3
radius = 4.5
knockback = 3.0
cast_range = 6.0
duration = PackedFloat64Array(1.5)

