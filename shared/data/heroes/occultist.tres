[sub_resource type="Resource" id="basic"]
script = ExtResource("2_skill")
id = &"occultist_basic"
icon = ExtResource("icon_basic")
display_name = "Projétil Sombrio"
description = "Lança um projétil sombrio (7,5 u) que para no primeiro inimigo e soma 1 marca de Maldição: cada marca tira 6 de Defesa do alvo (até 3 marcas, 4 s; a marca nova renova todas). A Muralha bloqueia. Dano: 90% do ATQ."
max_rank = 1
required_hero_level = PackedInt32Array(1)
cooldown = PackedFloat64Array(1.1)
attack_ratio = 0.9
attack_range = 7.5
radius = 0.4
speed = 15.0
duration = PackedFloat64Array(4.0)
curse_marks = 1

[sub_resource type="Resource" id="q"]
