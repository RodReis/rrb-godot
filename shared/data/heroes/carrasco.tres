[sub_resource type="Resource" id="e"]
script = ExtResource("2_skill")
id = &"carrasco_e"
icon = ExtResource("icon_e")
display_name = "Penitência"
description = "Canaliza até 2 s sem se mover: toma 40% menos dano, se cura aos poucos e ganha +1 Dor a cada 0,5 s. E de novo encerra antes. No fim, explode (3 u): com 4+ Dor prende por 1 s, senão deixa 40% mais lento por 1,5 s. Atordoado, cancela sem explodir. Cura e dano: base do rank + ATQ + 10 por Dor."
max_rank = 5
