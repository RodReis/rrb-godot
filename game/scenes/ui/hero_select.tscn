[node name="HeroSelect" type="CanvasLayer"]
layer = 3
script = ExtResource("1_script")

[node name="Backdrop" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"PanelCardSurface"
script = ExtResource("2_card")
variant = 0

[node name="Margin" type="MarginContainer" parent="Backdrop"]
layout_mode = 2
