[ext_resource type="Script" path="res://scripts/ui/hud_telemetry.gd" id="telemetry"]
[ext_resource type="Texture2D" path="res://shared/ui/icons/ui_skull.svg" id="skull"]

[node name="HudPhase1" type="CanvasLayer"]
script = ExtResource("hud")

[node name="Root" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="TopBar" type="HBoxContainer" parent="Root"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 40.0
offset_top = 24.0
