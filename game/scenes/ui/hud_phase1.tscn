[node name="GateColumn" type="VBoxContainer" parent="Root/TopBar/TopLeft/Gate/GateRow"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="GateText" type="Label" parent="Root/TopBar/TopLeft/Gate/GateRow/GateColumn"]
