variant = 3
accent = 3

[node name="GateRow" type="HBoxContainer" parent="Root/TopBar/TopLeft/Gate"]
layout_mode = 2

[node name="GateDot" type="Label" parent="Root/TopBar/TopLeft/Gate/GateRow"]
