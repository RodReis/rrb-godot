[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/arena/ilha_arcana.tscn" id="2_arena"]
[ext_resource type="Script" path="res://scripts/follow_camera.gd" id="3_cam"]
[ext_resource type="Script" path="res://scripts/match/spawn_director.gd" id="4_spawn"]
[ext_resource type="Script" path="res://scripts/match/match_clock.gd" id="5_clock"]
[ext_resource type="Resource" path="res://shared/data/rules/match_pacing.tres" id="6_rules"]
[ext_resource type="PackedScene" path="res://scenes/ui/hud.tscn" id="7_hud"]
[ext_resource type="PackedScene" path="res://scenes/ui/bestiary.tscn" id="8_bestiary"]
[ext_resource type="Script" path="res://scripts/match/match_controller.gd" id="9_match"]
[ext_resource type="PackedScene" path="res://scenes/ui/hero_select.tscn" id="10_pick"]
[ext_resource type="Script" path="res://scripts/match/zone_controller.gd" id="11_zone"]
[ext_resource type="Script" path="res://scripts/world/zone_ring.gd" id="12_ring"]
[ext_resource type="PackedScene" path="res://scenes/ui/match_end.tscn" id="13_end"]

[node name="Main" type="Node3D"]
script = ExtResource("1_main")

[node name="Arena" parent="." instance=ExtResource("2_arena")]

[node name="Spawns" type="Node3D" parent="."]
script = ExtResource("4_spawn")

[node name="MatchClock" type="Node" parent="."]
script = ExtResource("5_clock")
rules = ExtResource("6_rules")

[node name="ZoneController" type="Node" parent="." node_paths=PackedStringArray("clock")]
script = ExtResource("11_zone")
rules = ExtResource("6_rules")
clock = NodePath("../MatchClock")

[node name="ZoneRing" type="Node3D" parent="." node_paths=PackedStringArray("clock")]
script = ExtResource("12_ring")
clock = NodePath("../MatchClock")
rules = ExtResource("6_rules")

[node name="MatchController" type="Node" parent="." node_paths=PackedStringArray("clock", "zone")]
script = ExtResource("9_match")
rules = ExtResource("6_rules")
clock = NodePath("../MatchClock")
zone = NodePath("../ZoneController")

[node name="Players" type="Node3D" parent="."]

[node name="MultiplayerSpawner" type="MultiplayerSpawner" parent="."]

[node name="Sun" type="DirectionalLight3D" parent="."]
rotation = Vector3(-1, 0.6, 0)
shadow_enabled = true

[node name="Camera" type="Camera3D" parent="."]
current = true
script = ExtResource("3_cam")

[node name="UI" type="CanvasLayer" parent="."]

[node name="Status" type="Label" parent="UI"]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 40.0
offset_top = -34.0
offset_right = 900.0
offset_bottom = -8.0
grow_vertical = 0
theme_type_variation = &"LabelMuted"
text = "offline"

[node name="ConnectPanel" type="VBoxContainer" parent="UI"]
offset_left = 12.0
offset_top = 48.0
offset_right = 312.0
offset_bottom = 120.0

[node name="Address" type="LineEdit" parent="UI/ConnectPanel"]
layout_mode = 2
text = "127.0.0.1:7000"

[node name="ConnectButton" type="Button" parent="UI/ConnectPanel"]
layout_mode = 2
text = "Conectar"

[node name="Hud" parent="." instance=ExtResource("7_hud")]

[node name="Bestiary" parent="." instance=ExtResource("8_bestiary")]

[node name="HeroSelect" parent="." instance=ExtResource("10_pick")]

[node name="MatchEnd" parent="." instance=ExtResource("13_end")]
