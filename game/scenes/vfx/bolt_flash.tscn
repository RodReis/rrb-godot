[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/vfx/scaled_vfx.gd" id="1_script"]

[sub_resource type="Gradient" id="Gradient_chip"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(0.78, 0.6, 0.38, 1, 0.45, 0.32, 0.2, 0)

[sub_resource type="GradientTexture1D" id="GradientTexture1D_chip"]
gradient = SubResource("Gradient_chip")

[sub_resource type="ParticleProcessMaterial" id="PPM_chip"]
direction = Vector3(0, 0.4, -1)
spread = 35.0
initial_velocity_min = 2.0
initial_velocity_max = 3.5
gravity = Vector3(0, -9, 0)
angular_velocity_min = -360.0
angular_velocity_max = 360.0
color_ramp = SubResource("GradientTexture1D_chip")

[sub_resource type="StandardMaterial3D" id="Mat_chip"]
transparency = 1
vertex_color_use_as_albedo = true
albedo_color = Color(1, 1, 1, 1)

[sub_resource type="BoxMesh" id="BoxMesh_chip"]
material = SubResource("Mat_chip")
size = Vector3(0.03, 0.03, 0.09)

[sub_resource type="StandardMaterial3D" id="Mat_flash"]
transparency = 1
blend_mode = 1
shading_mode = 0
albedo_color = Color(2.2, 2.6, 1.8, 0.9)
billboard_mode = 1

[sub_resource type="QuadMesh" id="QuadMesh_flash"]
material = SubResource("Mat_flash")
size = Vector2(0.35, 0.35)

[node name="BoltFlash" type="Node3D"]
script = ExtResource("1_script")
lifetime = 0.25
light_seconds = 0.12
fade_seconds = 0.2

[node name="Chips" type="GPUParticles3D" parent="."]
cast_shadow = 0
emitting = false
amount = 4
lifetime = 0.25
one_shot = true
explosiveness = 1.0
local_coords = true
process_material = SubResource("PPM_chip")
draw_pass_1 = SubResource("BoxMesh_chip")

[node name="Glow" type="MeshInstance3D" parent="."]
cast_shadow = 0
mesh = SubResource("QuadMesh_flash")

[node name="Flash" type="OmniLight3D" parent="."]
